{
  "name": "@ansible/aap-mock",
  "version": "1.0.0",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "tsx src/server/server.ts",
    "generate": "tsx src/context/generate.ts",
    "test": "npm run eslint && npm run prettier && npm run tsc",
    "tsc": "tsc --noEmit",
    "eslint": "eslint --max-warnings=0 .",
    "eslint:fix": "eslint --fix .",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "fix": "concurrently npm:eslint:fix npm:prettier:fix -c auto"
  }
}
