{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@ansible/ansible-ui-framework": ["../../../framework"],
      "@ansible/ansible-ui-framework/*": ["../../../framework/*"],
      "@ansible/common-ui/*": ["../../common/*"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx", "../common/**/*.ts", "../common/**/*.tsx"],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "../common/**/*.test.ts",
    "../common/**/*.test.tsx"
  ]
}
