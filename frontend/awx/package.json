{
  "name": "@ansible/awx-ui",
  "type": "module",
  "version": "0.0.0",
  "dependencies": {
    "@ansible/ansible-ui-framework": "file:../../framework",
    "@ansible/common-ui": "file:../common"
  },
  "scripts": {
    "dump-nyc-vitest": "mkdir -p ../../.nyc_output && vitest run --coverage && mv coverage/vitest/coverage-final.json ../../.nyc_output/awx-vitest.json",
    "dump-nyc-pw": "mkdir -p ../../.nyc_output && npx playwright test --config ../../playwright/playwright.config.ts playwright/tests/automation-execution --project='live chromium' && mv coverage/playwright/coverage-final.json ../../.nyc_output/awx-playwright.json",
    "start": "vite --open --port 4101",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview --port 4101",
    "serve": "concurrently --kill-others-on-fail npm:preview npm:build:watch -c auto",
    "test": "concurrently npm:eslint npm:prettier npm:tsc npm:vitest -c auto",
    "tsc": "tsc --noEmit",
    "eslint": "eslint --max-warnings=0 .",
    "eslint:fix": "eslint --fix .",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "fix": "concurrently npm:eslint:fix npm:prettier:fix -c auto",
    "vitest": "vitest --run"
  }
}
