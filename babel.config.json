{
  "presets": [
    ["@babel/preset-react", { "runtime": "automatic" }],
    "@babel/preset-typescript",
    ["@babel/preset-env", { "modules": "auto" }]
  ],
  "plugins": [
    [
      "babel-plugin-styled-components",
      {
        "displayName": false,
        "fileName": false,
        "pure": true,
        "namespace": "ans"
      }
    ],
    "transform-class-properties",
    "istanbul"
  ]
}
