{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": [
    "@typescript-eslint",
    "i18next",
    "import",
    "jsx-a11y",
    "no-only-tests",
    "prettier",
    "react",
    "react-hooks",
    "sonarjs"
  ],
  "ignorePatterns": [
    "*.cjs",
    "**/publish/**",
    "**/dist/**",
    "**/build/**",
    "**/node_modules/**",
    "**/coverage/**",
    "**/*.test.*",
    "**/*.cy.*",
    "**/*.fixture.*",
    "**/generated/**",
    "**/*.config.*"
  ],
  "overrides": [
    {
      "files": ["frontend/**/*.{ts,tsx}", "platform/**/*.{ts,tsx}", "framework/**/*.{ts,tsx}"],
      "rules": {
        "max-lines": ["warn", 500],
        "max-lines-per-function": ["warn", 200],
        "complexity": ["warn", 20],
        "max-depth": ["warn", 4],
        "max-params": ["warn", 5],
        "max-nested-callbacks": ["warn", 4],
        "sonarjs/cognitive-complexity": ["warn", 15],
        "sonarjs/no-nested-conditional": "warn"
      }
    }
  ]
}
