{
  "name": "@ansible/hub-ui",
  "type": "module",
  "version": "1.0.0",
  "dependencies": {
    "@ansible/common-ui": "file:../common",
    "@ansible/ansible-ui-framework": "file:../../framework"
  },
  "scripts": {
    "dump-nyc-vitest": "mkdir -p ../../.nyc_output && vitest run --coverage && mv coverage/vitest/coverage-final.json ../../.nyc_output/hub-vitest.json",
    "dump-nyc-pw": "mkdir -p ../../.nyc_output && npx playwright test --config ../../playwright/playwright.config.ts playwright/tests/automation-hub --project='live chromium' && mv coverage/playwright/coverage-final.json ../../.nyc_output/hub-playwright.json",
    "start": "vite --open --port 4102",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview --port 4102",
    "serve": "concurrently --kill-others-on-fail npm:preview npm:build:watch -c auto",
    "test": "concurrently npm:eslint npm:prettier npm:tsc npm:vitest -c auto",
    "tsc": "tsc --noEmit",
    "eslint": "eslint --max-warnings=0 --ignore-pattern 'insights/' --ignore-pattern 'dist-insights/' .",
    "eslint:fix": "eslint --fix --ignore-pattern 'insights/' --ignore-pattern 'dist-insights/' .",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "fix": "concurrently npm:eslint:fix npm:prettier:fix -c auto",
    "vitest": "vitest --run",
    "insights:install": "cd insights && npm install --legacy-peer-deps",
    "insights:serve": "cd insights && npm run serve",
    "insights:build": "cd insights && npm run build",
    "insights:tsc": "cd insights && npm run tsc",
    "insights:eslint": "cd insights && npm run eslint"
  }
}
