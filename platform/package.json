{
  "name": "@ansible/platform-ui",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dump-nyc-vitest": "mkdir -p ../.nyc_output && vitest run --coverage && mv coverage/vitest/coverage-final.json ../.nyc_output/platform-vitest.json",
    "dump-nyc-pw": "mkdir -p ../.nyc_output && npx playwright test --config ../playwright/playwright.config.ts playwright/tests/platform --project='live chromium' && mv coverage/playwright/coverage-final.json ../.nyc_output/platform-playwright.json",
    "start": "vite --force --open --port 4100",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build:watch": "NODE_OPTIONS=--max-old-space-size=8192 vite build --watch",
    "preview": "vite preview --port 4100",
    "serve": "concurrently --kill-others-on-fail npm:preview npm:build:watch -c auto",
    "clean": "rm -rf node_modules dist coverage",
    "playwright-upgrades:run": "cd ../playwright && npx playwright test --grep @upgrade --project='mock chromium'",
    "playwright-nightly:run": "cd ../playwright && npx playwright test --grep-invert @not_e2e --project='mock chromium'",
    "podman:build": "podman build --tag platform-ui .",
    "podman:start": "npm run podman:stop && podman run --name platform-ui -d -p 4100:443 -e PLATFORM_SERVER=$PLATFORM_SERVER platform-ui --wait && open https://localhost:4100",
    "podman:stop": "podman rm -f platform-ui || true",
    "podman:run": "echo https://localhost:4100 && podman run --rm -p 4100:443 -e PLATFORM_SERVER=$PLATFORM_SERVER platform-ui",
    "podman:build:run": "npm run podman:build && npm run podman:run",
    "podman:update-snapshots": "cd .. && ./scripts/update-visual-baselines.sh",
    "test": "concurrently npm:eslint npm:prettier npm:tsc npm:vitest -c auto",
    "tsc": "tsc --noEmit",
    "eslint": "eslint --max-warnings=0 .",
    "eslint:fix": "eslint --fix .",
    "prettier": "prettier --check !dist/** .",
    "prettier:fix": "prettier --write !dist/** .",
    "fix": "concurrently npm:eslint:fix npm:prettier:fix -c auto",
    "vitest": "vitest --run"
  },
  "dependencies": {
    "@ansible/ansible-ui-framework": "file:../framework",
    "@ansible/awx-ui": "file:../frontend/awx",
    "@ansible/common-ui": "file:../frontend/common",
    "@ansible/eda-ui": "file:../frontend/eda",
    "@ansible/hub-ui": "file:../frontend/hub"
  }
}
