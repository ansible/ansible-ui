{
  "compilerOptions": {
    "target": "ES5",
    "module": "CommonJS",
    "lib": ["ES2021", "DOM"],
    "allowSyntheticDefaultImports": true,
    "allowJs": false,
    "sourceMap": false,
    "declaration": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "monaco-editor": ["./node_modules/monaco-editor/esm/vs/index.d.ts"]
    },
    "noImplicitAny": true,
    "outDir": "./publish/cjs",
    "removeComments": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "downlevelIteration": true
  },
  "include": ["framework"],
  "exclude": ["framework/vite.config.ts", "framework/vitest.shared.ts"]
}
