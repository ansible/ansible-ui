        "max_length": 512,
        "help_text": "Name of this host.",
        "filterable": true
      },
      "description": {
        "type": "string",
        "required": false,
        "hidden": false,
        "label": "Description",
        "help_text": "Optional description of this host.",
        "filterable": true,
        "default": ""
      },
      "inventory": {
        "type": "id",
        "required": true,
        "hidden": false,
        "label": "Inventory",
        "filterable": true
      },
      "enabled": {
        "type": "boolean",
        "required": false,
        "hidden": false,
        "label": "Enabled",
        "help_text": "Is this host online and available for running jobs?",
        "filterable": true,
        "default": true
      },
      "instance_id": {
        "type": "string",
        "required": false,
        "hidden": false,
        "label": "Instance id",
        "help_text": "The value used by the remote inventory source to uniquely identify the host",
