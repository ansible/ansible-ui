{
  "name": "@ansible/playwright",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "clean": "rm -rf allure-results allure-report coverage test-results blob-report .allure results.xml",
    "mock": "playwright test --project 'mock chromium' --grep-invert @not_mock",
    "live": "playwright test --project 'live chromium' --grep-invert @not_live",
    "compare": "playwright test --project 'live chromium' --grep @compare",
    "coverage": "open coverage/index.html",
    "allure": "allure generate allure-results && allure open",
    "test": "concurrently npm:eslint npm:prettier npm:tsc -c auto",
    "tsc": "tsc --noEmit",
    "eslint": "eslint --max-warnings=0 tests commands mock",
    "eslint:fix": "eslint --fix tests commands mock",
    "prettier": "prettier --check tests commands mock",
    "prettier:fix": "prettier --write tests commands mock",
    "fix": "concurrently npm:eslint:fix npm:prettier:fix -c auto",
    "markdown": "tsx generate-test-summary.ts"
  },
  "dependencies": {
    "@ansible/aap-mock": "file:../packages/aap-mock"
  }
}
