# Multi-stage Containerfile for local Linux visual baseline generation
# Uses official Playwright image for consistent rendering with CI

FROM mcr.microsoft.com/playwright:v1.57.0-noble@sha256:3bed4b1a12f2338642f3d8cba28e291deef3c66bd4a964bbeb3e57bbff511dbd AS platform-ui

WORKDIR /work

# Copy the full monorepo
COPY . .

# Install dependencies
RUN npm ci

# Build platform UI
RUN cd platform && npm run build

# Set environment variables
ENV PLATFORM_UI=https://localhost:4100
ENV PLATFORM_USERNAME=automation-admin
ENV VISUAL_TEST_PATH=tests/visual/
ENV SKIP_COVERAGE=true

# Expose port 4100
EXPOSE 4100

# Entrypoint: start Vite preview and run mock visual tests
RUN chmod +x /work/platform/run-visual-baselines-container.sh
CMD ["/work/platform/run-visual-baselines-container.sh"]
