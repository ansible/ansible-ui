{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ansible/ansible-ui/blob/devel/docs/dev/feature-flags.schema.json",
  "title": "Client-only feature flag catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["flags"],
  "properties": {
    "flags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flag"
      }
    }
  },
  "$defs": {
    "flag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "defaultValue",
        "description",
        "owner",
        "removalDate"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^FEATURE_[A-Z0-9_]+_ENABLED$"
        },
        "defaultValue": {
          "const": false
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "removalDate": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
