{
  "name": "@ansible/ui",
  "author": "Red Hat",
  "license": "Apache-2.0",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "windows"
  ],
  "cpu": [
    "x64",
    "arm64",
    "ppc64",
    "s390x"
  ],
  "workspaces": [
    "packages/*",
    "frontend/*",
    "framework",
    "platform",
    "playwright"
  ],
  "nyc": {
    "temp-directory": ".nyc_output",
    "report-dir": "coverage/combined",
    "reporter": [
      "html",
      "lcov"
    ]
  },
  "scripts": {
    "start": "npm --prefix platform start",
    "coverage:fix-paths": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\"}' npx ts-node ./fix-coverage-paths.ts",
    "nyc-report": "npm run coverage:fix-paths && npx nyc report --cwd=$(pwd)",
    "reinstall": "nx exec -- rm -rf node_modules && npm ci",
    "clean": "nx exec -- rm -rf dist build coverage test-results && rm -rf dist build coverage test-results && nx run-many --target=clean",
    "build": "nx run-many --target=build",
    "test": "nx run-many --target=eslint,tsc,prettier,vitest",
    "test:force": "nx run-many --target=eslint,tsc,prettier --skip-nx-cache",
    "vitest": "nx run-many --target=vitest",
    "vitest-preview": "vitest-preview",
    "tsc": "nx run-many --target=tsc",
    "prettier": "nx run-many --target=prettier",
    "prettier:fix": "nx run-many --target=prettier:fix",
    "eslint": "nx run-many --target=eslint",
    "eslint:fix": "nx run-many --target=eslint:fix",
    "fix": "nx run-many --target=eslint:fix,prettier:fix",
    "upgrade": "npx npm-check-updates -u --workspaces && npm npm-check-updates -u && npm i && npm test",
    "prepare": "husky",
    "i18n": "npx i18next-parser --config i18next-parser.config.cjs && npm run prettier:fix",
    "migrate:testid": "tsx scripts/migrate-data-cy-to-testid.ts",
    "insights:ci-build": "cd frontend/hub/insights && npm ci --legacy-peer-deps && npm run build && cd /opt/app-root/src && rm -f package-lock.json"
  },
  "dependencies": {
    "@ansible/ansible-ai-connect-chatbot": "^0.1.16",
    "@ansible/react-json-chart-builder": "3.0.0",
    "@babel/core": "7.26.7",
    "@babel/plugin-proposal-object-rest-spread": "7.20.7",
    "@babel/plugin-transform-class-properties": "^7.22.0",
    "@babel/preset-react": "7.26.3",
    "@babel/preset-typescript": "7.26.0",
    "@patternfly/patternfly": "6.5.1",
